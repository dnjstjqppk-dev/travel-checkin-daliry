# ==============================================================================
# Check-in Daily Environment Variables Example (.env.example)
#
# Copy this file to .env (or inject into your secrets manager / CI/CD pipeline).
# DO NOT COMMIT REAL SECRETS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Production & Domain Settings
# ------------------------------------------------------------------------------
# PRIMARY_DOMAIN: The canonical public domain for Check-in Daily (e.g. checkindaily.com)
# [Optional in development / Required in production / Public]
PRIMARY_DOMAIN=travel-checkin-daily.dnjstjqppk.workers.dev

# WWW_POLICY: Domain redirect policy ('redirect_to_apex' | 'redirect_to_www' | 'none')
# [Optional / Default: redirect_to_apex]
WWW_POLICY=redirect_to_apex

# STAGING_DOMAIN: Staging deployment domain
# [Optional / Public]
STAGING_DOMAIN=staging.checkindaily.workers.dev

# ------------------------------------------------------------------------------
# 2. Nuxt & Frontend Configuration
# ------------------------------------------------------------------------------
# NITRO_PRESET: Nitro build preset ('cloudflare_module' for Cloudflare Workers, 'node-server' for Docker/Node)
# [Optional / Default: cloudflare_module]
NITRO_PRESET=cloudflare_module

# BUILD_TARGET: Target runtime ('worker' or 'node')
# [Optional / Default: worker]
BUILD_TARGET=worker

# NUXT_PUBLIC_API_BASE: Public API base URL used by browser (leave empty for same-origin /api)
# [Optional / Public]
NUXT_PUBLIC_API_BASE=

# NUXT_API_INTERNAL_BASE: Server-side upstream API base URL if running separate Go backend
# [Optional / Server-only / Fallback: http://localhost:8080]
NUXT_API_INTERNAL_BASE=http://localhost:8080

# ------------------------------------------------------------------------------
# 3. Cloudflare D1 & Workers Configuration
# ------------------------------------------------------------------------------
# CLOUDFLARE_DATABASE_ID: D1 Database ID from `wrangler d1 list`
# [Required for Wrangler / Non-secret]
CLOUDFLARE_DATABASE_ID=db85821f-36a0-4af2-aadf-418e8aa39839

# CLOUDFLARE_DATABASE_NAME: D1 Database name binding
# [Non-secret]
CLOUDFLARE_DATABASE_NAME=checkin-daily-db

# ------------------------------------------------------------------------------
# 4. Backend (Go API & Auth) Configuration
# ------------------------------------------------------------------------------
# SESSION_SECRET: Cryptographic secret for signing admin session HMAC cookies (minimum 32 bytes)
# [Required / SECRET]
SESSION_SECRET=your-32-byte-long-cryptographic-secret-here-min32chars

# ADMIN_USERNAME: Bootstrap administrator username for initial DB setup
# [Optional in normal ops / Secret]
ADMIN_USERNAME=editor@checkindaily.com

# ADMIN_PASSWORD_HASH: Bcrypt password hash for initial bootstrap account
# [Optional in normal ops / Secret]
ADMIN_PASSWORD_HASH=$2a$10$abcdefghijklmnopqrstuvwxyz01234567890123456789012

# COOKIE_SECURE: Set to true for HTTPS production, false for local HTTP dev
# [Optional / Default: true]
COOKIE_SECURE=true

# CORS_ALLOWED_ORIGINS: Comma-separated allowed HTTP(S) origins
# [Optional / Default: http://localhost:3000]
CORS_ALLOWED_ORIGINS=https://travel-checkin-daily.dnjstjqppk.workers.dev,http://localhost:3000

# ------------------------------------------------------------------------------
# 5. External Services & Affiliate Integrations
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API key for automated AI journalism draft generator
# [Optional / Secret]
GEMINI_API_KEY=AIzaSyDummyKeyForDevelopment

# TRIPSCANNER_AFFILIATE_ID: Affiliate partner tag for TripScanner
# [Optional / Public]
TRIPSCANNER_AFFILIATE_ID=checkindaily

# GETFORTRIP_AFFILIATE_ID: Affiliate partner tag for GetForTrip
# [Optional / Public]
GETFORTRIP_AFFILIATE_ID=checkindaily

# ------------------------------------------------------------------------------
# 6. Operations & Monitoring
# ------------------------------------------------------------------------------
# OPERATIONS_EMAIL: Operations contact email for incident notices
# [Optional / Non-secret]
OPERATIONS_EMAIL=ops@checkindaily.com

# ADS_ENABLED: Set to true only when approved Google AdSense publisher ID is present
# [Optional / Default: false]
ADS_ENABLED=false
