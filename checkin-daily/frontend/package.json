{
  "name": "checkin-daily-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "build:worker": "nuxt build",
    "build:node": "node -e \"process.env.NITRO_PRESET='node-server'; require('node:child_process').spawnSync(process.platform==='win32'?'npx.cmd':'npx', ['nuxt', 'build'], {stdio: 'inherit', env: process.env})\"",
    "typecheck": "nuxt typecheck",
    "preview": "nuxt preview --host 0.0.0.0",
    "test": "node --import ./tests/register.mjs --test tests/*.test.ts"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.5.1",
    "isomorphic-dompurify": "^2.22.0",
    "marked": "^15.0.7",
    "nuxt": "^4.6.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.5"
  },
  "overrides": {
    "simple-git": "4.0.2"
  }
}
