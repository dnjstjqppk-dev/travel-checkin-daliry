# ==============================================================================
# Cloudflare Workers Local Development Variables Example (.dev.vars.example)
#
# For use with `wrangler dev` locally.
# DO NOT COMMIT REAL PRODUCTION SECRETS TO GIT.
# ==============================================================================

# Session signing secret (minimum 32 bytes)
SESSION_SECRET=dev-session-secret-at-least-32-bytes-long-for-testing

# Initial Admin Bootstrap Token (used to initialize admin account in fresh D1 database)
ADMIN_BOOTSTRAP_TOKEN=dev-admin-bootstrap-token-change-in-production

# External Gemini API Key (optional fallback for AI article generation)
GEMINI_API_KEY=AIzaSyDummyKeyForDevelopment

# Newsletter provider keys (leave empty to keep mail dispatch disabled)
RESEND_API_KEY=
SENDGRID_API_KEY=

# Web Push VAPID keys (leave empty to keep push disabled)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@checkindaily.news

# Shared secret for /api/cron/* endpoints (minimum 16 chars)
CRON_TOKEN=dev-cron-token-change-me-0000

